# SQLite by default. Use a Turso/libSQL URL for Vercel.
DATABASE_URL="file:./prisma/data/bayradar.db"

# Required in production. Used to encrypt/sign app secrets.
APP_SECRET="change-me"

# Optional. Protects /api/cron/poll except same-origin dashboard scans.
CRON_SECRET=""

# eBay Browse API (optional while the developer app is under review).
# Leave empty to auto-enable the mock catalog.
EBAY_APP_ID=""
EBAY_CERT_ID=""
EBAY_ENVIRONMENT="PRODUCTION"
EBAY_MARKETPLACE_ID="EBAY_DE"

# Force the simulated catalog: true | false
# Unset = Settings toggle, then auto-on when credentials are missing.
EBAY_MOCK_MODE=""

# Worker cadence when a monitor has no cron of its own.
WORKER_DEFAULT_CRON="*/5 * * * *"
POLLER_MODE="hybrid"
